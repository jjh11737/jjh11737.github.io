#!/usr/bin/env bash
# ============================================================
#  blog —— 个人主页的发布工具
#
#  日常只会用到这几条：
#    blog post "标题"         新建一篇文章（content/post/，公开；blog article 是别名）
#    blog note "标题" [分区]  新建一篇笔记（content/note/，默认 draft 不发布；blog wiki 是别名）
#    blog ub <分类> "标题"    新建一条 UB 条目，如 blog ub reading "《书名》"
#    blog save <文件>         提交并推送指定文件（nvim 的 <leader>bp 调的就是它）
#
#  其他：
#    blog preview             本地预览（含草稿和未来日期）
#    blog build               本地构建检查
#    blog publish             不带参数时提交 content/ 下的所有改动
#    blog tags                看标签统计
#    blog vis <文件> [public|hidden|draft]   控制单篇是否公开
#    blog tag [--apply]       按规则表自动生成标签（默认只预览）
#    blog doctor              体检：扫一遍内容，报告缺 title/date、未来日期等问题
# ============================================================
set -euo pipefail

ROOT="$(cd -- "$(dirname -- "$(readlink -f -- "$0")")/.." && pwd)"
CONTENT="$ROOT/content"
TYPES=(post)

die() { printf '\033[31m×\033[0m %s\n' "$*" >&2; exit 1; }
ok() { printf '\033[32m✓\033[0m %s\n' "$*" >&2; }
info() { printf '\033[36m·\033[0m %s\n' "$*" >&2; }

usage() {
  # 打印文件头那段 “#” 注释（从第 3 行到第一条 ==== 分隔线之间）
  sed -n '3,/^# ====/p' "$0" | sed '$d' | sed 's/^# \{0,1\}//'
  exit "${1:-0}"
}

check_type() {
  local t="$1" x
  for x in "${TYPES[@]}"; do [ "$x" = "$t" ] && return 0; done
  die "类型只能是: ${TYPES[*]}（收到: $t）"
}

slugify() {
  printf '%s' "$1" \
    | sed -E 's/[[:space:]]+/-/g' \
    | tr -d '/\:*?"<>|' \
    | sed -E 's/-+/-/g; s/^-+//; s/-+$//'
}

# 逗号分隔的标签 -> YAML 数组
to_yaml_tags() {
  local raw="$1" out=""
  [ -n "$raw" ] || { printf '[]'; return; }
  local IFS=','
  local t
  for t in $raw; do
    t="$(printf '%s' "$t" | sed -E 's/^[[:space:]]+//; s/[[:space:]]+$//')"
    [ -n "$t" ] || continue
    [ -n "$out" ] && out="$out, "
    out="$out\"${t//\"/\\\"}\""
  done
  printf '[%s]' "$out"
}

frontmatter() { # $1=type $2=title $3=datetime $4=tags
  local t="$1" title="$2" ts="$3" tags="$4"
  printf -- '---\n'
  printf 'title: "%s"\n' "${title//\"/\\\"}"
  printf 'date: %s\n' "$ts"
  printf 'draft: false\n'
  case "$t" in
    post)    printf 'tags: %s\ncategories: []\nsummary: ""\n' "$tags" ;;
    reading) printf 'author: ""\nstatus: "在读"\nrating: 0\nlink: ""\ntags: %s\n' "$tags" ;;
    music)   printf 'artist: ""\nlink: ""\ntags: %s\n' "$tags" ;;
    *)       printf 'tags: %s\n' "$tags" ;;
  esac
  printf -- '---\n\n'
}

new_file() { # $1=内容子目录 $2=标题 $3=frontmatter 模板名 $4=标签 -> 输出文件路径
  local dir="$1" title="$2" tmpl="$3" tags="$4"
  local file="$CONTENT/$dir/$(date +%Y-%m-%d)-$(slugify "$title").md"
  if [ -e "$file" ]; then
    info "已存在: $file"
  else
    mkdir -p "$CONTENT/$dir"
    frontmatter "$tmpl" "$title" "$(date +%Y-%m-%dT%H:%M:%S%:z)" "$tags" > "$file"
    ok "新建: ${file#"$ROOT"/}"
  fi
  printf '%s' "$file"
}

# ------------------------------------------------------------
#  新建
# ------------------------------------------------------------
cmd_new() {
  local type="${1:-}" title="${2:-}" tagarg="${3:-}"
  [ -n "$type" ] || usage 1
  check_type "$type"
  [ -n "$title" ] || die "缺少标题: blog new $type \"标题\""

  local file
  file="$(new_file "$type" "$title" "$type" "$(to_yaml_tags "$tagarg")")"
  if [ -t 0 ] && [ -t 1 ]; then
    "${EDITOR:-nvim}" "$file"
  else
    info "非交互环境，跳过后面的编辑器调用"
  fi
}

# ------------------------------------------------------------
#  UB 栏目的条目
#
#    blog ub <分类> "标题" [标签]   分类 = content/ub/ 下的目录（reading / music / 以后加的）
# ------------------------------------------------------------
cmd_ub() {
  local kind="${1:-}" title="${2:-}" tagarg="${3:-}"
  local ub_root="$CONTENT/ub"
  local kinds
  kinds="$(ls "$ub_root" 2>/dev/null | grep -v '\.md$' | tr '\n' ' ' | sed 's/ $//')"

  [ -n "$kind" ] || die "用法: blog ub <分类> \"标题\"（现有分类: $kinds）"
  [ -n "$title" ] || die "用法: blog ub $kind \"标题\""
  [ -d "$ub_root/$kind" ] || die "没有这个分类: $kind（现有: $kinds）"

  local file
  file="$(new_file "ub/$kind" "$title" "$kind" "$(to_yaml_tags "$tagarg")")"
  if [ -t 0 ] && [ -t 1 ]; then
    "${EDITOR:-nvim}" "$file"
  else
    info "非交互环境，跳过后面的编辑器调用"
  fi
}

# ------------------------------------------------------------
#  提交 / 推送
# ------------------------------------------------------------
title_of() {
  grep -m1 '^title:' "$1" 2>/dev/null \
    | sed -E 's/^title:[[:space:]]*//; s/^"//; s/"$//' || true
}

warn_about() { # $1=相对 ROOT 的路径
  local f="$1" abs="$ROOT/$1" d
  [ -f "$abs" ] || return 0
  case "$f" in
    content/*.md | content/*/*.md | content/*/*/*.md) ;;
    *) return 0 ;; # 只检查内容文件
  esac
  if ! grep -q '^title:' "$abs" 2>/dev/null; then
    info "提醒: $f 没有 title，页面上会是空标题（跑一下 blog doctor 可以整体体检）"
  fi
  if ! grep -q '^date:' "$abs" 2>/dev/null; then
    info "提醒: $f 没有 date，不会进归档页、RSS 里的排序也会乱"
  fi
  if grep -qE '^draft:[[:space:]]*true' "$abs" 2>/dev/null; then
    info "提醒: $f 是 draft，线上不会渲染"
  fi
  d="$(grep -m1 '^date:' "$abs" 2>/dev/null | sed -E 's/^date:[[:space:]]*//; s/^"//; s/"$//' || true)"
  if [ -n "$d" ]; then
    local ts
    ts="$(date -d "$d" +%s 2>/dev/null || echo 0)"
    if [ "$ts" -gt "$(date +%s)" ]; then
      info "提醒: $f 的日期在未来，Hugo 正式构建时不会发布它"
    fi
  fi
}

cmd_publish() {
  if [ $# -gt 0 ]; then
    git -C "$ROOT" add -- "$@"
  else
    git -C "$ROOT" add -A
  fi

  if git -C "$ROOT" diff --cached --quiet; then
    info "没有需要提交的改动"
    return 0
  fi

  # 注意 -c core.quotePath=false：否则中文文件名会被转义成 "content/note/\346..." 这种形式
  local msg f
  f="$(git -C "$ROOT" -c core.quotePath=false diff --cached --name-only --diff-filter=ACM -- content | head -n1 || true)"
  if [ -n "$f" ]; then
    local t
    t="$(title_of "$ROOT/$f")"
    if [ -n "$t" ]; then
      msg="[$(basename "$(dirname "$f")")] $t"
    fi
  fi
  [ -n "${msg:-}" ] || msg="content: 更新 $(git -C "$ROOT" diff --cached --name-only | wc -l | tr -d ' ') 个文件"

  while IFS= read -r f; do
    [ -n "$f" ] && warn_about "$f"
  done < <(git -C "$ROOT" -c core.quotePath=false diff --cached --name-only)

  git -C "$ROOT" commit -q -m "$msg"
  ok "已提交: $msg"

  if git -C "$ROOT" remote get-url origin >/dev/null 2>&1; then
    if git -C "$ROOT" push -q 2>/dev/null; then
      ok "已推送，等 CI 跑完就上线了"
    elif ! git -C "$ROOT" rev-parse --abbrev-ref --symbolic-full-name '@{u}' >/dev/null 2>&1; then
      info "这个分支还没有上游，先跑一次: git push -u origin $(git -C "$ROOT" branch --show-current)"
      info "（如果远端仓库还没建好，push 失败是正常的，本地已经提交了）"
    else
      info "push 失败，rebase 后重试"
      git -C "$ROOT" pull --rebase --autostash
      git -C "$ROOT" push -q
      ok "已推送"
    fi
  else
    info "还没配 remote，改动只在本地（git remote add origin <你的仓库>）"
  fi
}

# ------------------------------------------------------------
#  其他
# ------------------------------------------------------------
cmd_preview() {
  cd "$ROOT"
  info "预览: http://localhost:1313/（含草稿和未来日期）"
  exec hugo server -D -F --navigateToChanged
}

cmd_build() {
  cd "$ROOT"
  hugo --gc --minify --cleanDestinationDir
  ok "构建完成，产物在 public/"
}

cmd_tags() {
  grep -rhoE '^tags:.*' "$CONTENT" \
    | sed -E 's/^tags:[[:space:]]*\[//; s/\][[:space:]]*$//' \
    | tr ',' '\n' \
    | sed -E 's/^[[:space:]]*//; s/[[:space:]]*$//; s/^"//; s/"$//' \
    | grep -v '^$' \
    | sort | uniq -c | sort -rn
}

# ------------------------------------------------------------
#  单篇可见性
#
#    public  收录：进搜索索引、RSS、sitemap，页面允许索引
#    hidden  不收录：知道链接能看，但不进索引/feed/sitemap，带 noindex
#    draft   不发布：构建产物里根本没有这一页
#
#  注意 hidden/public 是相对"收录"而言；要让它出现在首页列表里，
#  把文件挪到 content/post/ 这类主 section 下。
# ------------------------------------------------------------
VIS_USAGE='用法: blog vis <文件> [public|hidden|draft]'

cmd_vis() {
  local file="${1:-}" mode="${2:-}"
  [ -n "$file" ] || die "$VIS_USAGE"
  [ -f "$file" ] || die "文件不存在: $file"

  if [ -z "$mode" ]; then
    python3 - "$file" <<'PY'
import re, sys

path = sys.argv[1]
raw = open(path, encoding='utf-8', newline='').read()
lines = raw.replace('\r\n', '\n').replace('\r', '').split('\n')
if not lines or lines[0].strip() != '---':
    print(f'{path}: 没有 frontmatter')
    sys.exit(0)

end = next((i for i, l in enumerate(lines[1:], 1) if l.strip() == '---'), None)
fm = lines[1:end] if end is not None else []

def get(key):
    for i, l in enumerate(fm):
        m = re.match(r'^%s:\s*(.*)$' % key, l)
        if m:
            v = m.group(1).strip()
            if v:
                return v
            for j in range(i + 1, len(fm)):
                if not fm[j].strip():
                    continue
                return fm[j].strip() if fm[j].startswith((' ', '\t')) else None
    return None

vals = {k: (get(k) or '未设置') for k in ('draft', 'hiddenInRss', 'searchHidden', 'robotsNoIndex', 'sitemap')}
hidden_all = all(vals[k] in ('true', 'disable: true') for k in ('hiddenInRss', 'searchHidden', 'robotsNoIndex'))
if vals['draft'] == 'true':
    state = 'draft（不会出现在构建产物里）'
elif vals['hiddenInRss'] == '未设置' and vals['searchHidden'] == '未设置':
    state = '跟随所在目录的默认（隐藏区的默认是"不收录"）'
elif hidden_all:
    state = 'hidden（不收录，链接可访问）'
else:
    state = 'public（会被收录）'

print(f'{path}')
print(f'  状态: {state}')
for k, v in vals.items():
    print(f'  {k}: {v}')
PY
    return
  fi

  case "$mode" in public | hidden | draft) ;; *) die "$VIS_USAGE" ;; esac

  python3 - "$file" "$mode" <<'PY'
import re, sys

path, mode = sys.argv[1], sys.argv[2]
VALUES = {
    'public': [('draft', 'false'), ('hiddenInRss', 'false'), ('searchHidden', 'false'),
               ('robotsNoIndex', 'false'), ('sitemap', 'false')],
    'hidden': [('draft', 'false'), ('hiddenInRss', 'true'), ('searchHidden', 'true'),
               ('robotsNoIndex', 'true'), ('sitemap', 'true')],
    'draft':  [('draft', 'true'), ('hiddenInRss', 'true'), ('searchHidden', 'true'),
               ('robotsNoIndex', 'true'), ('sitemap', 'true')],
}
managed = '|'.join(sorted({'draft', 'hiddenInRss', 'searchHidden', 'robotsNoIndex', 'sitemap'}))

raw = open(path, encoding='utf-8', newline='').read()
lines = raw.replace('\r\n', '\n').replace('\r', '').split('\n')
if lines and lines[0].strip() == '---':
    end = next((i for i, l in enumerate(lines[1:], 1) if l.strip() == '---'), None)
    if end is None:
        sys.exit('frontmatter 没有闭合的 ---')
    fm, rest = lines[1:end], lines[end:]
else:
    # 没有 frontmatter 就补一个（rest 先放上闭合的那一行 ---）
    fm, rest = [], ['---'] + lines

kept, skipping = [], False
for l in fm:
    if re.match(r'^(%s):' % managed, l):
        skipping = True
        continue
    if skipping and l.startswith((' ', '\t')):
        continue
    skipping = False
    kept.append(l)
while kept and not kept[-1].strip():
    kept.pop()

for key, value in VALUES[mode]:
    if key == 'sitemap':
        kept += ['sitemap:', '  disable: %s' % value]
    else:
        kept.append('%s: %s' % (key, value))

open(path, 'w', encoding='utf-8').write('\n'.join(['---'] + kept + rest))
print('%s → %s' % (path, mode))
PY
  ok "可见性已设为 $mode"
}

# ------------------------------------------------------------
#  写笔记（content/note/）
#
#    blog note "标题" [分区]   分区默认 others，可选值见 content/note/ 下的目录
#    默认写 draft: true —— 存下来了但线上完全不存在，想发再 blog vis
# ------------------------------------------------------------
cmd_note() {
  local title="${1:-}" section="${2:-others}"
  local notes_root="$CONTENT/note"
  local sections
  sections="$(ls "$notes_root" 2>/dev/null | grep -v '\.md$' | tr '\n' ' ' | sed 's/ $//')"

  [ -n "$title" ] || die "用法: blog note \"标题\" [分区]（分区默认 others，可选: $sections）"
  local dir="$notes_root/$section"
  [ -d "$dir" ] || die "分区不存在: $section（可选: $sections）"

  local slug
  slug="$(slugify "$title")"
  [ -n "$slug" ] || die "标题里没有能用作文件名的字符"

  local file="$dir/$slug.md" n=2
  while [ -e "$file" ]; do
    file="$dir/$slug-$n.md"
    n=$((n + 1))
  done

  {
    printf -- '---\n'
    printf 'title: "%s"\n' "${title//\"/\\\"}"
    printf 'date: %s\n' "$(date +%Y-%m-%dT%H:%M:%S%:z)"
    printf 'draft: true\n'
    printf -- '---\n\n'
  } > "$file"
  ok "新建笔记: ${file#"$ROOT"/}"
  info "现在是 draft：本地能预览，线上不会出现（详见 blog vis）"

  if [ -t 0 ] && [ -t 1 ]; then
    "${EDITOR:-nvim}" "$file"
    if [ -f "$ROOT/scripts/tag.py" ]; then
      info "写完了，顺手按规则表补标签…"
      python3 "$ROOT/scripts/tag.py" --apply "${file#"$ROOT"/}" >/dev/null 2>&1 || true
      local tags
      tags="$(grep -m1 '^noteTags:' "$file" 2>/dev/null || true)"
      [ -n "$tags" ] && info "  ${tags}"
    fi
  fi

  info "接下来："
  info "  blog vis ${file#"$ROOT"/} hidden   # 只有直达链接能看，不进栏目"
  info "  blog vis ${file#"$ROOT"/} public   # 出现在顶部导航的 note 栏目里"
  info "  然后 blog save 或 nvim 里 <leader>bp 推上去"
}

cmd_tag() {
  local mode="--dry" targets=()
  while [ $# -gt 0 ]; do
    case "$1" in
      --apply) mode="--apply"; shift ;;
      --dry | --dry-run) mode="--dry"; shift ;;
      --clear) mode="--clear"; shift ;;
      -h | --help)
        printf '用法: blog tag [--apply|--clear] [文件...]\n'
        return 0
        ;;
      *)
        targets+=("$1")
        shift
        ;;
    esac
  done
  exec python3 "$ROOT/scripts/tag.py" "$mode" "${targets[@]+"${targets[@]}"}"
}

case "${1:-}" in
  new)     shift; cmd_new "$@" ;;
  article|post) shift; cmd_new post "$@" ;;
  note|wiki)    shift; cmd_note "$@" ;;
  ub)      shift; cmd_ub "$@" ;;
  save)    shift; cmd_publish "$@" ;;
  publish) shift; cmd_publish "$@" ;;
  preview|serve) shift; cmd_preview ;;
  build)   shift; cmd_build ;;
  tags)    shift; cmd_tags ;;
  tag)     shift; cmd_tag "$@" ;;
  doctor)  shift; exec python3 "$ROOT/scripts/doctor.py" "$@" ;;
  vis|visibility) shift; cmd_vis "$@" ;;
  ""|-h|--help|help) usage 0 ;;
  *) die "未知命令: $1（用 blog --help 看用法）" ;;
esac
